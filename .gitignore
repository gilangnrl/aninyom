# Local environment and secrets. Keep environment files out of Git by default.
.env
.env.*
!frontend/.env.production.example

# Python environments, bytecode, and test/tool caches
.venv/
venv/
**/.venv/
**/venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Node and frontend build output
node_modules/
**/node_modules/
frontend/dist/
frontend/.vite/
dist/
coverage/
*.tsbuildinfo

# Local databases and application runtime data
/data/
/backend/data/
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
*.sqlite-journal
*.sqlite-wal
*.sqlite-shm

# Logs and temporary files
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*
.DS_Store
Thumbs.db

# Editors and operating systems
.idea/
.vscode/
!.vscode/extensions.json
*.swp
*.swo

# Generated codebase graph artifacts
graphify-out/
