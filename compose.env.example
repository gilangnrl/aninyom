# Optional local Docker Compose overrides. These are development values only.
POSTGRES_USER=aninyom
POSTGRES_PASSWORD=change-this-local-password
POSTGRES_DB=aninyom
POSTGRES_PORT=5432
REDIS_PORT=6379
PORT=8000

# Metadata failover (optional). AniList occasionally disables its public API;
# the catalog then falls through to the next provider in this list.
# Order matters: "anilist,jikan,kitsu" is the default.
METADATA_PROVIDERS=anilist,jikan,kitsu
# JIKAN_BASE=https://api.jikan.moe/v4
# KITSU_BASE=https://kitsu.app/api/edge
# Seconds a cached payload may be served after its TTL while all upstreams fail.
METADATA_STALE_TTL=604800
